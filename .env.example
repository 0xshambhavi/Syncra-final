# Optional frontend override. Defaults to http://localhost:8000
VITE_API_URL=http://localhost:8000

# Production integration placeholders (not required for local demo)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Comma-separated institution email domains. Empty means no domain allow-list in local development.
INSTITUTION_EMAIL_DOMAINS=
# Long random secret required to provision the institution's Principal account.
SYNCRA_ADMIN_KEY=
SYNCRA_ENV=development
SESSION_HOURS=72
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
